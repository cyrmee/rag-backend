DATABASE_URL=postgresql://raguser:ragpass@localhost:5432/ragdb
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=qwen3-embedding:latest
CHAT_BASE_URL=http://localhost:8101/v1
# Optional; sent as a Bearer token when set
# CHAT_API_KEY=
CHAT_MODEL=chat
# Must match the chat server's --max-model-len
CHAT_NUM_CTX=32768
EMBED_DIM=1024
CHUNK_SIZE=500
TOP_K=15
MAX_AGENT_ITERATIONS=10
COUNCIL_ANGLES=6
COUNCIL_MAX_CHUNKS=20
AUTO_COUNCIL=true
# Research mode (mode="research" on /ask): rounds of search+read, documents
# the planner may pick, chunks per search query, chunks read per round, and
# excerpt tokens per reading call. Each sets how long a research turn takes.
RESEARCH_MAX_ROUNDS=2
RESEARCH_MAX_DOCUMENTS=20
RESEARCH_CHUNKS_PER_QUERY=25
RESEARCH_MAX_CHUNKS=250
RESEARCH_BATCH_TOKENS=7000
VISION_MODEL=qwen3-vl-caption:latest
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=ragminio
MINIO_SECRET_KEY=ragminiosecret
MINIO_BUCKET=rag-images
MINIO_SECURE=false
# Host:port browsers use to reach MinIO, for links to original files in answers
# (e.g. this machine's LAN/Tailscale IP:9000). Unset: links use MINIO_ENDPOINT.
# MINIO_PUBLIC_ENDPOINT=
SEARXNG_BASE_URL=http://localhost:8080

# Docker compose only: where the backend container reaches the model servers.
# Defaults: the host's vLLM (:8101) and Ollama (:11434) via host.docker.internal.
# DOCKER_CHAT_BASE_URL=http://host.docker.internal:8101/v1
# DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
